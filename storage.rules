rules_version = '2';

/*
  Reglas de seguridad de Firebase Storage para Creately.

  La app sube archivos de deals a la ruta uploads/{uid}/deals/{dealId}/{archivo}
  (ver index.html, subida de archivos de un entregable). Cada usuario solo puede
  leer, subir y borrar archivos dentro de SU PROPIA carpeta uploads/{su uid}/.

  Nadie puede leer los archivos de otra persona, ni siquiera otro usuario con
  sesion iniciada. Es el mismo criterio que firestore.rules.

  Limites: maximo 20 MB por archivo. Cualquier otra ruta del bucket queda
  denegada por defecto en el bloque final.
*/
service firebase.storage {
  match /b/{bucket}/o {

    match /uploads/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Cualquier otra ruta no listada arriba: denegada por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
